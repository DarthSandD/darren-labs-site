/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://api.web3forms.com; form-action https://api.web3forms.com; frame-ancestors 'none'; base-uri 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
/*.css
  Cache-Control: public, max-age=86400
/*.js
  Cache-Control: public, max-age=86400
/*.svg
  Cache-Control: public, max-age=86400
/*.woff2
  Cache-Control: public, max-age=86400
/*.png
  Cache-Control: public, max-age=86400
/*.html
  Cache-Control: no-cache
/*
  Cache-Control: no-cache
